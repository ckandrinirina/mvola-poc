MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_MERCHANT_MSISDN=
MVOLA_PARTNER_NAME=
MVOLA_COMPANY_NAME=
MVOLA_ENV=sandbox
MVOLA_CALLBACK_URL=

# Client polling policy (src/lib/mvola/polling.ts) — exposed to the browser via
# GET /api/config/polling, never read directly from the client.
# How often the browser polls a pending transaction's status, in milliseconds.
MVOLA_POLL_INTERVAL_MS=3000
# How long the browser keeps polling before reporting "still pending" instead of a
# timeout failure. Sized generously because a sandbox transaction settles only after
# a human approves it in MVola's developer portal — too short and a live demo reports
# a timeout while the presenter is still clicking.
MVOLA_POLL_TIMEOUT_MS=120000
